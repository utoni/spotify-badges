[Unit]
Description=Spotify Badges - Generate spotify SVG web badges.
Documentation=https://github.com/utoni/spotify-badges
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/spotify-badges
Restart=on-failure
RestartSec=2
DynamicUser=yes
StateDirectory=spotify-badges
RootDirectory=/var/lib/spotify-badges/root
MountAPIVFS=yes

BindReadOnlyPaths=/etc/resolv.conf
BindReadOnlyPaths=/etc/hosts
BindReadOnlyPaths=/etc/nsswitch.conf
BindReadOnlyPaths=/usr/bin/spotify-badges
BindReadOnlyPaths=/lib64
BindReadOnlyPaths=/lib/x86_64-linux-gnu
BindReadOnlyPaths=/etc/ld.so.cache

Environment=SPOTIFY_CLIENT_ID=
Environment=SPOTIFY_CLIENT_SECRET=
Environment=SPOTIFY_REFRESH_TOKEN=
Environment=AUTH_SECRET=
Environment=TOKEN_FILE=/var/lib/spotify-badges/refresh_token
Environment=API_CORS_HOST=*
Environment=LISTEN_ADDR=127.0.0.1
Environment=LISTEN_PORT=3000
Environment=BASE_PATH=
Environment=PUBLIC_URL=

MemoryHigh=200M
MemoryMax=256M
MemorySwapMax=0
CPUQuota=10%
CPUWeight=50
TasksMax=16
IOWeight=50
LimitNOFILE=8192

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateDevices=yes
PrivateTmp=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
